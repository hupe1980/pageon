class PageonError(Exception): ...

class Capture:
    @staticmethod
    def load(path: str) -> Capture: ...
    @staticmethod
    def from_json(text: str) -> Capture: ...
    @property
    def url(self) -> str: ...
    @property
    def title(self) -> str: ...
    @property
    def step(self) -> int: ...
    @property
    def baselines(self) -> dict[str, str]: ...
    def bid_of(self, frame_id: str, backend_node_id: int) -> str | None: ...
    def center(self, backend_node_id: int, frame_id: str | None = None) -> tuple[float, float] | None: ...

class _Episode:
    def __init__(self, budget: int = 4000, tokenizer: str = "o200k", mode: str = "full") -> None: ...
    @property
    def version(self) -> int: ...
    def observe(self, capture: Capture) -> str: ...
    def note_action(self, verb: str, reference: str, error: str | None = None) -> None: ...
    def resolve_raw(self, reference: str, capture: Capture) -> dict: ...

def ax(capture: Capture, budget: int = 4000, tokenizer: str = "o200k") -> str: ...
def count_tokens(text: str) -> int: ...
def cut_head_tail(text: str, budget: int, tokenizer: str = "o200k") -> str: ...

__version__: str
