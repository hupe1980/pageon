# Generated by scripts/release/formula.sh for pageon @VERSION@; do not edit.
class Pageon < Formula
  desc "Browser engine built for AI agents: compact page views, stable refs, sandboxed pages"
  homepage "https://hupe1980.github.io/pageon/"
  version "@VERSION@"
  license any_of: ["MIT", "Apache-2.0"]

  on_macos do
    on_arm do
      url "https://github.com/hupe1980/pageon/releases/download/v@VERSION@/pageon-@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA256_aarch64-apple-darwin@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/hupe1980/pageon/releases/download/v@VERSION@/pageon-@VERSION@-aarch64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA256_aarch64-unknown-linux-gnu@"
    end
    on_intel do
      url "https://github.com/hupe1980/pageon/releases/download/v@VERSION@/pageon-@VERSION@-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA256_x86_64-unknown-linux-gnu@"
    end
  end

  def install
    # One binary: V8, the fonts and the sandbox's content process are built into it.
    bin.install "pageon"
  end

  def caveats
    <<~EOS
      Add pageon to an MCP host:
        claude mcp add pageon -- pageon mcp
      The Python package drives this binary: pip install pageon
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/pageon --version")
    (testpath/"page.html").write "<h1>Hello</h1><button>Go</button>"
    assert_match 'button e1 "Go"', shell_output("#{bin}/pageon fetch #{testpath}/page.html --dump ax")
  end
end
