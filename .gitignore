# Generated by Cargo
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt

# macOS / editors
.DS_Store
.idea/
.vscode/

# Maintainers' local working notes and Spec Kit planning; not part of pageon.
# Public documentation and packages must not depend on these paths.
/concepts/
/specs/
/.specify/
/.claude/
/CLAUDE.md

# Local environment files, captured pages and benchmark evidence
.env*
*.log
/benchmark-results/
/corpus/

# Benchmark runs and Python artifacts
/bench/runs/
/bench/.venv/
/bench/.cache/
**/__pycache__/
*.pyc
*.so

# Real-page captures contain third-party content: local only. Re-capture them with the
# commands in crates/pageon-agent/tests/corpus/SOURCES.md.
/crates/pageon-agent/tests/corpus/real-*
/crates/pageon-agent/tests/snapshots/ax@real-*.snap

# The website build
/site/public/

# Native build artifacts of the Python package
bindings/python/python/pageon/*.so
bindings/python/python/pageon/*.dSYM/
